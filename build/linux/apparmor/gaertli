# Ubuntu's AppArmor denies user namespaces to programs without a profile;
# WebKitGTK's web-process sandbox (bubblewrap) needs them. Ubuntu's own shape
# for such applications: unconfined, user namespaces allowed.
abi <abi/4.0>,
include <tunables/global>

profile gaertli /usr/bin/gaertli flags=(unconfined) {
  userns,

  include if exists <local/gaertli>
}
