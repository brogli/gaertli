#!/usr/bin/env sh
# Starts the Windows app beside this script. In WSL, converts every
# non-flag argument to a Windows path first.

app="$(dirname "$(dirname "$(realpath "$0")")")/nebegit.exe"

if [ -n "$WSL_DISTRO_NAME" ]; then
	for arg; do
		shift
		case "$arg" in
		-*) ;;
		*) arg="$(wslpath -w "$arg")" || exit ;;
		esac
		set -- "$@" "$arg"
	done
fi

"$app" "$@" </dev/null >/dev/null 2>&1 &
exit 0
