{
  "name": "nebegit-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:stylelint",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@openuxkit/styled": "1.0.0",
    "@openuxkit/themes": "1.1.0",
    "@openvue/openicons": "1.0.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@vueuse/core": "14.4.0",
    "@wailsio/runtime": "3.0.0-beta.24",
    "openvue": "1.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-i18n": "11.4.12"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.11.0",
    "happy-dom": "20.14.5",
    "jiti": "2.7.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
