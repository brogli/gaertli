{
  "name": "nebegit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@openvue/themes": "1.0.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^14.4.0",
    "@wailsio/runtime": "3.0.0-beta.24",
    "openvue": "1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.83.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.0.0",
    "jiti": "^2.0.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  }
}
