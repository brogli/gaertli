{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    // Test-only: a guard test walks the source tree with node:fs.
    "types": ["vite/client", "node"]
