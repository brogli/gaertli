{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    // Test-only: src/__tests__/i18n.spec.ts's guard walks the source tree with node:fs.
    "types": ["vite/client", "node"]
  },
  // include and exclude here replace tsconfig.app.json's. vue-tsc --build
  // checks only files its project lists (TS6307), so app code is listed too.
  "include": ["src/**/*.ts", "src/**/*.vue", "bindings/**/*.ts"],
  "exclude": []
}
