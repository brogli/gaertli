{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Nix shell's Node major, in its attribute name.",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["\\bnodejs_(?<currentValue>\\d+)\\b"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "The Nix shell's pnpm major, in its attribute name.",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["\\bpnpm_(?<currentValue>\\d+)\\b"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "minimumReleaseAge": "7 days",
  "constraints": { "pnpm": "12" },
  "postUpdateOptions": ["gomodTidy"],
  "nix": { "enabled": true },
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "packageRules": [
    {
      "description": "config:best-practices sets 3 days for npm; keep 7.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "An app, not a library: pin production dependencies too.",
      "matchDatasources": ["npm"],
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "pin"
    },
    {
      "description": "These updates carry no release timestamp; pnpm's minimumReleaseAge gates them at resolution.",
      "matchUpdateTypes": ["pin", "pinDigest", "lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    { "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"], "automerge": true },
    {
      "description": "0.x minors and patches may break.",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "One lock file maintenance PR per lock file.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "additionalBranchPrefix": "{{manager}}-"
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prBodyNotes": [
        "The Nix shell supplies Playwright's browsers: if `playwright-driver` moved, set `@playwright/test` in `frontend/package.json` to its version in this PR (CI's e2e:real fails until then)."
      ]
    },
    {
      "description": "Moves only with the Nix input that supplies its browsers.",
      "matchPackageNames": ["@playwright/test"],
      "enabled": false
    },
    {
      "description": "The runtime must equal the Go module's version.",
      "groupName": "Wails",
      "matchPackageNames": ["github.com/wailsapp/wails/v3", "@wailsio/runtime"],
      "automerge": false
    },
    {
      "description": "Node's major moves in the Nix shell and its types at once.",
      "matchDepNames": ["node", "@types/node"],
      "groupName": "Node"
    },
    {
      "description": "pnpm's major moves in the Nix shell and Renovate's constraint at once.",
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Indirect modules compiled into release builds. The other indirect modules serve dev builds and the tools in go.mod, and move with them.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchPackageNames": [
        "github.com/adrg/xdg",
        "github.com/creachadair/mds",
        "github.com/go-ole/go-ole",
        "github.com/godbus/dbus/v5",
        "golang.org/x/mod",
        "golang.org/x/sync"
      ],
      "enabled": true,
      "groupName": "indirect Go modules"
    },
    {
      "description": "flake.lock follows nixpkgs-unstable on the next Renovate run instead of weekly, so nixpkgs security fixes land as soon as the channel has them.",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "schedule": ["at any time"]
    },
    {
      "description": "A toolchain bump is re-tested as main moves: it may wait for the Nix shell's golangci-lint to read the new compiler's export data.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "rebaseWhen": "behind-base-branch"
    }
  ]
}
